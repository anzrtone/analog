{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Analog",
  "mainBinaryName": "analog",
  "version": "../package.json",
  "identifier": "app.analoglog.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Analog",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#17181C",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "HealthcareAndFitness",
    "shortDescription": "A private gym logbook",
    "longDescription": "Analog is a free, private training log: programs, sets, rest timer, history and stats. No account, no ads, no tracking; everything stays on your device.",
    "copyright": "© The Analog contributors. AGPL-3.0-only.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
